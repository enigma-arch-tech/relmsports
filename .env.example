# ---------------------------------------------------------------------------
# RELM Sports — environment variables
# Copy this file to `.env` for local development.
# On Vercel, add these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Port for the local server (ignored on Vercel).
PORT=3000

# "production" when deployed; "development" locally.
NODE_ENV=production

# Comma-separated list of emails that automatically receive admin access.
ADMIN_EMAILS=relmtournaments@outlook.com

# ---------------------------------------------------------------------------
# Administrator sign in (/admin/login). Checked server-side only — never sent
# to the browser. Leave ADMIN_PASSWORD unset to disable the route.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@relmsports.com
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# New-application email notifications (Resend).
# ADMIN_NOTIFICATION_EMAIL is the recipient; RESEND_API_KEY is required for
# mail to actually be sent. Without it, submissions still succeed and the skip
# is logged. RESEND_FROM must be a verified sender once a domain is added.
# ---------------------------------------------------------------------------
ADMIN_NOTIFICATION_EMAIL=relmtournaments@outlook.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=RELM Sports <notifications@relmsports.com>

# Secret used to sign session tokens. Use a long random value so sessions
# stay valid across serverless invocations. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Optional durable storage (recommended on Vercel).
# Serverless instances have no persistent disk, so accounts and applications
# are otherwise kept in an ephemeral temp folder that resets on cold starts.
# Connect Vercel KV or Upstash Redis and Vercel injects these automatically:
# ---------------------------------------------------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
